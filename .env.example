# Copia este archivo como .env y rellénalo. NUNCA subas .env a GitHub.

# --- Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=

# --- Broker: "simulado" (sin dinero, para probar) o "alpaca" ---
BROKER=simulado

# --- Alpaca (https://alpaca.markets) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = cuenta de práctica de Alpaca, false = dinero real
ALPACA_PAPER=true

# --- Límites de riesgo (en la moneda de la cuenta) ---
MAX_POR_OPERACION=50
MAX_PERDIDA_DIARIA=10
CAPITAL_MINIMO=150
MAX_OPERACIONES_SEMANA=5
STOP_LOSS_PCT=8
# Lista de valores que el agente puede operar (nada fuera de aquí)
SIMBOLOS_PERMITIDOS=QQQ,VTI,AAPL,MSFT

# Tope de gasto en Claude al mes (en dólares). Si se alcanza, el agente no llama a la IA.
# Con 200 de capital, 2 $/mes ya son ~12 % al año: la IA solo se consulta los días con avisos.
MAX_GASTO_IA_MES=2

# --- Filtro de costes: Claude debe esperar al menos esta rentabilidad (%) y esta confianza (1-10) ---
MIN_RENTABILIDAD_PCT=2
MIN_CONFIANZA=6

# --- Impuestos (España): no recomprar un valor vendido con pérdidas en los 2 meses siguientes,
# para que la pérdida se pueda compensar en la renta ---
REGLA_DOS_MESES=true

# --- Núcleo-satélite: NUCLEO_PCT del patrimonio en un índice amplio que nunca se vende
# (aplaza impuestos y apenas tiene costes). El resto es lo que mueve el agente.
# Vacío = desactivado. En la UE puede que no te dejen comprar ETFs de EE. UU. (normativa PRIIPs):
# en ese caso usa un ETF europeo equivalente o una acción.
NUCLEO_SIMBOLO=SPY
NUCLEO_PCT=0.6
# Dinero ficticio con el que empieza el broker simulado
CAPITAL_SIMULADO=200

# true = te pregunta antes de cada orden; false = opera solo
CONFIRMAR_ORDENES=true
